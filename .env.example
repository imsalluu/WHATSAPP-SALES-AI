# Environment Configuration
PROJECT_NAME="WhatsApp Sales AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & Secrets
SECRET_KEY="super-secret-production-encryption-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
# Use PostgreSQL with pgvector in production, or SQLite in local testing mode
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_sales_ai"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_sales_ai"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI / LLM Providers
OPENAI_API_KEY="sk-mock-or-live-key-for-sales-agent"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# WhatsApp Business Cloud API Defaults
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_API_URL="https://graph.facebook.com"
WHATSAPP_DEFAULT_VERIFY_TOKEN="sales_ai_webhook_verify_secret"
WHATSAPP_APP_SECRET="mock_app_secret_for_signature_validation"

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
